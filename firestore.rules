rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só quem estiver nesta lista consegue ver e lançar. Coloque os e-mails Google da casa.
    function permitido() {
      return request.auth != null
        && request.auth.token.email in [
          'jonathan.soares06@gmail.com',
          'jonathan.plataformas@gmail.com',
          'bianca.161094@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if permitido();
    }
  }
}
